# AUTO CASH Environment Configuration

# ==========================================
# 1. Supabase Cloud Database (Free & Permanent)
# ==========================================
# Get these from: Supabase Project Settings -> API
NEXT_PUBLIC_SITE_URL=https://www.auto-cash.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# 2. Admin Security
# ==========================================
# Generate each secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=replace-with-a-random-64-char-hex-string
SESSION_SECRET=replace-with-a-different-random-64-char-hex-string
# Admin panel PIN: 8+ characters, never the old public default
ADMIN_PIN=replace-with-a-strong-admin-pin

# ==========================================
# 3. Environment
# ==========================================
NODE_ENV=production

# ==========================================
# 4. External Gaming Providers:
# ==========================================
# Provider 1: Sahl Cash (api.sahl-cash.com)
SAHL_CASH_BASE_URL=https://api.sahl-cash.com
SAHL_CASH_API_TOKEN=your-sahl-cash-api-token

# Provider 2: Othman Store (api.othman-storee.com)
OTHMAN_STORE_BASE_URL=https://api.othman-storee.com
OTHMAN_STORE_API_TOKEN=your-othman-store-api-token

# Legacy aliases (optional fallback)
SYRIA4GAME_BASE_URL=https://api.sahl-cash.com
SYRIA4GAME_API_TOKEN=your-sahl-cash-api-token

# ==========================================
# 5. Scheduled jobs (catalog sync / order status polling)
# ==========================================
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically (16+ characters).
# Supabase pg_cron (see supabase_schema.sql section 10) must send the same header.
CRON_SECRET=replace-with-a-random-secret
# Required on Vercel: the catalog and order tables are only accessible to the service role
# (SUPABASE_SERVICE_ROLE_KEY above).

# ==========================================
# 6. Sham Cash Auto-Deposit API (tsa-api.com)
# ==========================================
# Private API key from https://tsa-api.com/api/docs
TSA_API_KEY=your-tsa-api-key
# Your Sham Cash merchant wallet address
SHAMCASH_ADDRESS=efe8a2b200d66411c7c7e296369cbba8
# Exchange rate for Syrian Pounds (1 USD = X SYP)
SHAMCASH_EXCHANGE_RATE=15000
# Enable automated verification (true/false)
TSA_AUTO_DEPOSIT=true

# ==========================================
# 7. Telegram Bot (@Autocash_24_bot)
# ==========================================
# Bot API Token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Admin Telegram Chat ID for instant notifications
TELEGRAM_ADMIN_CHAT_ID=7575664493
# Admin Telegram username
TELEGRAM_ADMIN_USERNAME=nasrulla0996
# Bot username
TELEGRAM_BOT_USERNAME=Autocash_24_bot
 
# PhoneCash SMS API
PHONECASH_BASE_URL=https://app.phonecash.sy/api/api.php
PHONECASH_API_KEY=
