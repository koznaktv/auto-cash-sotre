# AUTO CASH Environment Configuration

# ==========================================
# 1. Supabase Cloud Database (Free & Permanent)
# ==========================================
# Get these from: Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# 2. Admin Security
# ==========================================
# Generate each secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=replace-with-a-random-64-char-hex-string
SESSION_SECRET=replace-with-a-different-random-64-char-hex-string
# Admin panel PIN: 8+ characters, never the old public default
ADMIN_PIN=replace-with-a-strong-admin-pin

# ==========================================
# 3. Environment
# ==========================================
NODE_ENV=production

# ==========================================
# 4. External Gaming Provider (syria4game.com)
# ==========================================
SYRIA4GAME_BASE_URL=https://syria4game.com
# syria4game account menu → "API للمبرمجين" → API TOKEN (leave the provider-side IP whitelist empty on Vercel)
SYRIA4GAME_API_TOKEN=your-syria4game-api-token

# ==========================================
# 5. Scheduled jobs (catalog sync / order status polling)
# ==========================================
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically (16+ characters).
# Supabase pg_cron (see supabase_schema.sql section 10) must send the same header.
CRON_SECRET=replace-with-a-random-secret
# Required on Vercel: the catalog and order tables are only accessible to the service role
# (SUPABASE_SERVICE_ROLE_KEY above).
